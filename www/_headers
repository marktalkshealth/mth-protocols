# Cloudflare Pages: pages and code always check for a fresh copy (so site updates show up right away).
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/assets/*.css
  Cache-Control: no-cache
/assets/*.js
  Cache-Control: no-cache
/assets/*.mjs
  Cache-Control: no-cache
  Content-Type: text/javascript; charset=utf-8
